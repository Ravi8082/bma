# ---- runtime ----
NODE_ENV=development
PORT=4000
APP_BASE_URL=http://localhost:4000
DASHBOARD_ORIGIN=http://localhost:5173

# ---- data stores (separate roles, separate secrets) ----
DATABASE_URL=postgres://bma_app:dev-app-password@localhost:5432/business_memory?sslmode=disable
MIGRATION_DATABASE_URL=postgres://bma_migrator:dev-migrator-password@localhost:5432/business_memory?sslmode=disable
DB_POOL_MAX=20
DB_SSL_MODE=disable
REDIS_URL=redis://localhost:6379

# inline = in-process queue (local demo only, refused in production)
QUEUE_DRIVER=inline

# ---- auth (Phase 2 uses these; Phase 1 only validates presence in production) ----
JWT_SECRET_CURRENT=dev-only-change-me-32-bytes-minimum-secret
ACCESS_TOKEN_TTL=12m
REFRESH_TOKEN_TTL=30d
COOKIE_SECURE=false
CSRF_SECRET=dev-only-csrf-secret-32-bytes-minimum

# ---- application secrets (never commit real values) ----
OTP_PEPPER=dev-only-otp-pepper-32-bytes-minimum
PHONE_BLIND_INDEX_KEY=dev-only-blind-index-key-32-bytes
FIELD_ENCRYPTION_KEY_REF=dev-local-kms-key

# ---- messaging ----
MESSAGING_PROVIDER=simulator
WHATSAPP_VERIFY_TOKEN=dev-verify-token
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# ---- ai ----
LLM_PROVIDER=stub
LLM_API_KEY=
STT_PROVIDER=stub
STT_API_KEY=

# ---- storage ----
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=./.data/media

# ---- policy defaults ----
DEFAULT_TIMEZONE=Asia/Kolkata
DRAFT_TTL_MINUTES=30
MAX_ENTRY_PAISE=100000000000

# ---- ops ----
LOG_LEVEL=info
