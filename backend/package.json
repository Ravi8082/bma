{
  "name": "@bma/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "db:bootstrap": "tsx src/scripts/db-bootstrap.ts",
    "db:migrate": "tsx src/scripts/db-migrate.ts",
    "check:tenant": "tsx src/scripts/check-tenant.ts",
    "build": "tsup src/server.ts --format esm --target node22 --platform node --sourcemap --clean --out-dir dist",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:catalog": "vitest run src/test/db/catalog.test.ts",
    "eval:extraction": "tsx src/scripts/eval-extraction.ts",
    "eval:deterministic": "tsx src/scripts/eval-deterministic.ts"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "pg": "^8.23.1",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "postgres-migrations": "^5.3.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^10.16.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.5",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^6.0.2",
    "embedded-postgres": "^18.6.0-beta.19",
    "pino-pretty": "^13.0.0",
    "supertest": "^7.0.0",
    "testcontainers": "^10.16.0",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^3.0.5"
  }
}
